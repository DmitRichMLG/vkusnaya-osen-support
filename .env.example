# Скопируйте этот файл в .env и впишите два ключа ниже. Остальное менять не обязательно.

# --- Ключи (обязательно) ---
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# --- Вход в панель операторов: http://localhost:8080 ---
OPERATOR_EMAIL=admin@example.com
OPERATOR_PASSWORD=password

# --- Модели Gemini по порядку: при сбое или исчерпанной квоте берётся следующая ---
# На бесплатном тарифе квота считается на каждую модель отдельно, поэтому цепочка длинная.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

# --- Ниже менять не нужно ---
APP_NAME="Вкусная осень"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=promo
DB_USERNAME=promo
DB_PASSWORD=promo

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
